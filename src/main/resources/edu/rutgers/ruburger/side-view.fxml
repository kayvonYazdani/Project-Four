<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.rutgers.ruburger.SideController"
            fitToWidth="true">

    <VBox alignment="TOP_CENTER" spacing="16"
          style="-fx-background-color: #FFF8F0;">

        <padding>
            <Insets top="25" right="40" bottom="25" left="40"/>
        </padding>

        <Label text="ORDER A SIDE"
               style="-fx-font-size: 30px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #8B0000;"/>

        <ImageView fx:id="itemImage" fitWidth="220" fitHeight="160"
                   preserveRatio="true"/>

        <Label text="Side" style="-fx-font-size: 17px;"/>
        <ComboBox fx:id="typeBox" prefWidth="260"
                  onAction="#updatePrice"/>

        <Label text="Size (+$0.50 medium, +$1.00 large)"
               style="-fx-font-size: 17px;"/>
        <HBox alignment="CENTER" spacing="25">
            <RadioButton fx:id="smallSize" text="Small"
                         onAction="#updatePrice"/>
            <RadioButton fx:id="mediumSize" text="Medium"
                         onAction="#updatePrice"/>
            <RadioButton fx:id="largeSize" text="Large"
                         onAction="#updatePrice"/>
        </HBox>

        <Label text="Quantity"/>
        <Spinner fx:id="quantitySpinner" prefWidth="120"
                 editable="false"/>

        <Label text="Total Price"
               style="-fx-font-size: 18px;"/>

        <Label fx:id="priceLabel"
               text="0.00"
               minWidth="180"
               alignment="CENTER"
               style="-fx-font-family: 'Arial';
                      -fx-font-size: 28px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #8B0000;"/>

        <HBox alignment="CENTER" spacing="20">
            <Button text="Back"
                    prefWidth="140"
                    onAction="#goBack"
                    onMouseEntered="#highlightButton"
                    onMouseExited="#resetButton"/>

            <Button text="Add to Order"
                    prefWidth="180"
                    onAction="#addToOrder"
                    onMouseEntered="#highlightButton"
                    onMouseExited="#resetButton"/>
        </HBox>

    </VBox>
</ScrollPane>
