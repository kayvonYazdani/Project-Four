<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.rutgers.ruburger.SandwichController"
            fitToWidth="true">

    <VBox alignment="TOP_CENTER" spacing="14"
          style="-fx-background-color: #FFF8F0;">

        <padding>
            <Insets top="20" right="40" bottom="20" left="40"/>
        </padding>

        <Label text="BUILD YOUR SANDWICH"
               style="-fx-font-size: 30px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #8B0000;"/>

        <ImageView fx:id="itemImage" fitWidth="220" fitHeight="150"
                   preserveRatio="true"/>

        <HBox alignment="CENTER" spacing="30">
            <VBox alignment="CENTER" spacing="5">
                <Label text="Bread" style="-fx-font-size: 16px;"/>
                <ComboBox fx:id="breadBox" prefWidth="200"
                          onAction="#updatePrice"/>
            </VBox>
            <VBox alignment="CENTER" spacing="5">
                <Label text="Protein" style="-fx-font-size: 16px;"/>
                <ComboBox fx:id="proteinBox" prefWidth="200"
                          onAction="#updatePrice"/>
            </VBox>
        </HBox>

        <Label text="Add-ons" style="-fx-font-size: 16px;"/>

        <HBox alignment="CENTER" spacing="15">
            <CheckBox fx:id="lettuce" text="Lettuce (+$0.30)"
                      onAction="#updatePrice"/>
            <CheckBox fx:id="tomatoes" text="Tomatoes (+$0.30)"
                      onAction="#updatePrice"/>
            <CheckBox fx:id="onions" text="Onions (+$0.30)"
                      onAction="#updatePrice"/>
        </HBox>

        <HBox alignment="CENTER" spacing="20">
            <CheckBox fx:id="avocado" text="Avocado (+$0.50)"
                      onAction="#updatePrice"/>
            <CheckBox fx:id="cheese" text="Cheese (+$1.00)"
                      onAction="#updatePrice"/>
        </HBox>

        <CheckBox fx:id="combo" text="Make it a Combo (+$2.00)"
                  onAction="#updatePrice"/>

        <HBox alignment="CENTER" spacing="30">
            <VBox alignment="CENTER" spacing="5">
                <Label text="Combo side (small)"/>
                <ImageView fx:id="comboSideImage" fitWidth="90"
                           fitHeight="70" preserveRatio="true"/>
                <ComboBox fx:id="comboSideBox" prefWidth="150"
                          onAction="#updatePrice"/>
            </VBox>
            <VBox alignment="CENTER" spacing="5">
                <Label text="Combo drink (medium)"/>
                <ImageView fx:id="comboDrinkImage" fitWidth="90"
                           fitHeight="70" preserveRatio="true"/>
                <ComboBox fx:id="comboDrinkBox" prefWidth="150"
                          onAction="#updatePrice"/>
            </VBox>
        </HBox>

        <Label text="Quantity"/>
        <Spinner fx:id="quantitySpinner" prefWidth="120"
                 editable="false"/>

        <Label text="Total Price"
               style="-fx-font-size: 18px;"/>

        <Label fx:id="priceLabel"
               text="0.00"
               minWidth="180"
               alignment="CENTER"
               style="-fx-font-family: 'Arial';
                      -fx-font-size: 28px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #8B0000;"/>

        <HBox alignment="CENTER" spacing="20">
            <Button text="Back"
                    prefWidth="140"
                    onAction="#goBack"
                    onMouseEntered="#highlightButton"
                    onMouseExited="#resetButton"/>

            <Button text="Add to Order"
                    prefWidth="180"
                    onAction="#addToOrder"
                    onMouseEntered="#highlightButton"
                    onMouseExited="#resetButton"/>
        </HBox>

    </VBox>
</ScrollPane>
