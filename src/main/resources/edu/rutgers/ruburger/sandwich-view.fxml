<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.rutgers.ruburger.SandwichController"
      stylesheets="@styles.css"
            fitToWidth="true">

    <VBox alignment="TOP_CENTER" spacing="14"
          styleClass="root-pane">

        <padding>
            <Insets top="20" right="40" bottom="20" left="40"/>
        </padding>

        <Label text="BUILD YOUR SANDWICH"
               styleClass="title-label"/>

        <ImageView fx:id="itemImage" fitWidth="220" fitHeight="150"
                   preserveRatio="true"/>

        <HBox alignment="CENTER" spacing="30">
            <VBox alignment="CENTER" spacing="5">
                <Label text="Bread" styleClass="section-label"/>
                <ComboBox fx:id="breadBox" prefWidth="200"
                          onAction="#updatePrice"/>
            </VBox>
            <VBox alignment="CENTER" spacing="5">
                <Label text="Protein" styleClass="section-label"/>
                <ComboBox fx:id="proteinBox" prefWidth="200"
                          onAction="#updatePrice"/>
            </VBox>
        </HBox>

        <Label text="Add-ons" styleClass="section-label"/>

        <HBox alignment="CENTER" spacing="15">
            <CheckBox fx:id="lettuce" text="Lettuce (+$0.30)"
                      onAction="#updatePrice"/>
            <CheckBox fx:id="tomatoes" text="Tomatoes (+$0.30)"
                      onAction="#updatePrice"/>
            <CheckBox fx:id="onions" text="Onions (+$0.30)"
                      onAction="#updatePrice"/>
        </HBox>

        <HBox alignment="CENTER" spacing="20">
            <CheckBox fx:id="avocado" text="Avocado (+$0.50)"
                      onAction="#updatePrice"/>
            <CheckBox fx:id="cheese" text="Cheese (+$1.00)"
                      onAction="#updatePrice"/>
        </HBox>

        <CheckBox fx:id="combo" text="Make it a Combo (+$2.00)"
                  onAction="#updatePrice"/>

        <HBox alignment="CENTER" spacing="15">
            <Label fx:id="comboSummaryLabel" text="Small Chips + Medium Cola"
                   styleClass="section-label"/>
            <Button fx:id="comboButton" text="Choose Side &amp; Drink"
                    onAction="#chooseCombo"
                    onMouseEntered="#highlightButton"
                    onMouseExited="#resetButton"/>
        </HBox>

        <Label text="Quantity"/>
        <Spinner fx:id="quantitySpinner" prefWidth="120"
                 editable="false"/>

        <Label text="Total Price"
               styleClass="section-label"/>

        <Label fx:id="priceLabel"
               text="0.00"
               minWidth="180"
               alignment="CENTER"
               styleClass="price-label"/>

        <HBox alignment="CENTER" spacing="20">
            <Button text="Back"
                    prefWidth="140"
                    onAction="#goBack"
                    onMouseEntered="#highlightButton"
                    onMouseExited="#resetButton"/>

            <Button text="Add to Order" styleClass="primary-button"
                    prefWidth="180"
                    onAction="#addToOrder"
                    onMouseEntered="#highlightButton"
                    onMouseExited="#resetButton"/>
        </HBox>

    </VBox>
</ScrollPane>
