<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.rutgers.ruburger.CurrentOrderController"
      alignment="TOP_CENTER"
      spacing="16"
      prefWidth="850"
      prefHeight="650"
      style="-fx-background-color: #FFF8F0;">

    <padding>
        <Insets top="25" right="35"
                bottom="25" left="35"/>
    </padding>

    <Label text="CURRENT ORDER"
           style="-fx-font-size: 30px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #8B0000;"/>

    <Label fx:id="orderNumberLabel"
           text="Order #1"
           style="-fx-font-size: 17px;"/>

    <Label text="Items in your order"
           style="-fx-font-size: 16px;"/>

    <ListView fx:id="orderListView"
              prefHeight="290"
              VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER" spacing="15">
        <Button fx:id="removeButton"
                text="Remove Selected"
                prefWidth="160"
                onAction="#removeSelectedItem"/>

        <Button fx:id="clearButton"
                text="Clear Order"
                prefWidth="160"
                onAction="#clearOrder"/>
    </HBox>

    <Separator/>

    <GridPane hgap="25" vgap="10"
              alignment="CENTER">

        <Label text="Subtotal:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <Label fx:id="subtotalLabel"
               text="0.00"
               GridPane.rowIndex="0"
               GridPane.columnIndex="1"/>

        <Label text="NJ Sales Tax (6.625%):"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <Label fx:id="taxLabel"
               text="0.00"
               GridPane.rowIndex="1"
               GridPane.columnIndex="1"/>

        <Label text="Order Total:"
               style="-fx-font-weight: bold;
                      -fx-font-size: 19px;"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <Label fx:id="totalLabel"
               text="0.00"
               style="-fx-font-weight: bold;
                      -fx-font-size: 23px;
                      -fx-text-fill: #8B0000;"
               GridPane.rowIndex="2"
               GridPane.columnIndex="1"/>
    </GridPane>

    <HBox alignment="CENTER" spacing="20">
        <Button text="Back to Menu"
                prefWidth="160"
                onAction="#goBack"/>

        <Button fx:id="placeButton"
                text="Place Order"
                prefWidth="160"
                onAction="#placeOrder"
                style="-fx-background-color: #8B0000;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>
    </HBox>

</VBox>
