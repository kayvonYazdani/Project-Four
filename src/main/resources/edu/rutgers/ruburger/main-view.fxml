<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.rutgers.ruburger.MainController"
      alignment="CENTER"
      spacing="15"
      style="-fx-background-color: #FFF8F0;">

    <padding>
        <Insets top="30" right="30"
                bottom="30" left="30"/>
    </padding>

    <Label text="RU BURGER"
           style="-fx-font-size: 36px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #8B0000;"/>

    <Label text="Restaurant Ordering System"
           style="-fx-font-size: 18px;
                  -fx-text-fill: #555555;"/>

    <Button text="Order Burger"
            onAction="#orderBurger"
            prefWidth="250"
            prefHeight="45"/>

    <Button text="Order Sandwich"
            onAction="#orderSandwich"
            prefWidth="250"
            prefHeight="45"/>

    <Button text="Order Beverage"
            onAction="#orderBeverage"
            prefWidth="250"
            prefHeight="45"/>

    <Button text="Order Side"
            onAction="#orderSide"
            prefWidth="250"
            prefHeight="45"/>

    <Button text="Current Order"
            onAction="#viewOrder"
            prefWidth="250"
            prefHeight="45"/>

    <Button text="Placed Orders"
            onAction="#viewOrders"
            prefWidth="250"
            prefHeight="45"/>

</VBox>
