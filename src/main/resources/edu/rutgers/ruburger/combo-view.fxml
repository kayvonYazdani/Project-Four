<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.rutgers.ruburger.ComboController"
      stylesheets="@styles.css"
      alignment="TOP_CENTER" spacing="16"
      styleClass="root-pane">

    <padding>
        <Insets top="25" right="35" bottom="25" left="35"/>
    </padding>

    <Label text="CHOOSE YOUR COMBO" styleClass="title-label"/>

    <Label text="Includes a small side and a medium drink for +$2.00"
           styleClass="subtitle-label"/>

    <HBox alignment="CENTER" spacing="50">
        <VBox alignment="CENTER" spacing="8">
            <Label text="Side (small)" styleClass="section-label"/>
            <ImageView fx:id="sideImage" fitWidth="160" fitHeight="120"
                       preserveRatio="true"/>
            <ComboBox fx:id="sideBox" prefWidth="170"
                      onAction="#updateImages"/>
        </VBox>

        <VBox alignment="CENTER" spacing="8">
            <Label text="Drink (medium)" styleClass="section-label"/>
            <ImageView fx:id="drinkImage" fitWidth="160" fitHeight="120"
                       preserveRatio="true"/>
            <ComboBox fx:id="drinkBox" prefWidth="170"
                      onAction="#updateImages"/>
        </VBox>
    </HBox>

    <HBox alignment="CENTER" spacing="20">
        <Button text="Cancel" prefWidth="140" onAction="#cancel"
                onMouseEntered="#highlightButton"
                onMouseExited="#resetButton"/>
        <Button text="Confirm" prefWidth="160" styleClass="primary-button"
                onAction="#confirm"
                onMouseEntered="#highlightButton"
                onMouseExited="#resetButton"/>
    </HBox>
</VBox>
