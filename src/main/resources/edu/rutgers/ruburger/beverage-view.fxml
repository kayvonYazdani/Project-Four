<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.rutgers.ruburger.BeverageController"
      stylesheets="@styles.css"
            fitToWidth="true">

    <VBox alignment="TOP_CENTER" spacing="16"
          styleClass="root-pane">

        <padding>
            <Insets top="25" right="40" bottom="25" left="40"/>
        </padding>

        <Label text="ORDER A BEVERAGE"
               styleClass="title-label"/>

        <ImageView fx:id="itemImage" fitWidth="220" fitHeight="160"
                   preserveRatio="true"/>

        <Label text="Flavor" styleClass="section-label"/>
        <ComboBox fx:id="flavorBox" prefWidth="260"
                  onAction="#updatePrice"/>

        <Label text="Size" styleClass="section-label"/>
        <HBox alignment="CENTER" spacing="25">
            <RadioButton fx:id="smallSize" text="Small ($1.99)"
                         onAction="#updatePrice"/>
            <RadioButton fx:id="mediumSize" text="Medium ($2.49)"
                         onAction="#updatePrice"/>
            <RadioButton fx:id="largeSize" text="Large ($2.99)"
                         onAction="#updatePrice"/>
        </HBox>

        <Label text="Quantity"/>
        <Spinner fx:id="quantitySpinner" prefWidth="120"
                 editable="false"/>

        <Label text="Total Price"
               styleClass="section-label"/>

        <Label fx:id="priceLabel"
               text="0.00"
               minWidth="180"
               alignment="CENTER"
               styleClass="price-label"/>

        <HBox alignment="CENTER" spacing="20">
            <Button text="Back"
                    prefWidth="140"
                    onAction="#goBack"
                    onMouseEntered="#highlightButton"
                    onMouseExited="#resetButton"/>

            <Button text="Add to Order" styleClass="primary-button"
                    prefWidth="180"
                    onAction="#addToOrder"
                    onMouseEntered="#highlightButton"
                    onMouseExited="#resetButton"/>
        </HBox>

    </VBox>
</ScrollPane>
