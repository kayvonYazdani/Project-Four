<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.rutgers.ruburger.BurgerController"
      stylesheets="@styles.css"
            fitToWidth="true">

    <VBox alignment="TOP_CENTER" spacing="18"
          styleClass="root-pane">

        <padding>
            <Insets top="25" right="40"
                    bottom="25" left="40"/>
        </padding>

        <Label text="BUILD YOUR BURGER"
               styleClass="title-label"/>

        <ImageView fx:id="itemImage" fitWidth="220" fitHeight="150"
                   preserveRatio="true"/>

        <Label text="Choose your bread"
               styleClass="section-label"/>

        <ComboBox fx:id="breadBox"
                  prefWidth="260"/>

        <Label text="Patty selection"
               styleClass="section-label"/>

        <HBox alignment="CENTER" spacing="25">
            <RadioButton fx:id="singlePatty"
                         text="Single Patty"
                         onAction="#updatePrice"/>
            <RadioButton fx:id="doublePatty"
                         text="Double Patty (+$2.50)"
                         onAction="#updatePrice"/>
        </HBox>

        <Label text="Add-ons"
               styleClass="section-label"/>

        <HBox alignment="CENTER" spacing="15">
            <CheckBox fx:id="lettuce"
                      text="Lettuce"
                      onAction="#updatePrice"/>
            <CheckBox fx:id="tomatoes"
                      text="Tomatoes"
                      onAction="#updatePrice"/>
            <CheckBox fx:id="onions"
                      text="Onions"
                      onAction="#updatePrice"/>
        </HBox>

        <HBox alignment="CENTER" spacing="20">
            <CheckBox fx:id="avocado"
                      text="Avocado"
                      onAction="#updatePrice"/>
            <CheckBox fx:id="cheese"
                      text="Cheese"
                      onAction="#updatePrice"/>
        </HBox>

        <CheckBox fx:id="combo"
                  text="Make it a Combo (+$2.00)"
                  onAction="#updatePrice"/>

        <HBox alignment="CENTER" spacing="15">
            <Label fx:id="comboSummaryLabel" text="Small Chips + Medium Cola"
                   styleClass="section-label"/>
            <Button fx:id="comboButton" text="Choose Side &amp; Drink"
                    onAction="#chooseCombo"/>
        </HBox>

        <Label text="Quantity"/>
        <Spinner fx:id="quantitySpinner"
                 prefWidth="120"
                 editable="false"/>

        <Label text="Total Price"
               styleClass="section-label"/>

        <Label fx:id="priceLabel"
               text="6.99"
               minWidth="180"
               alignment="CENTER"
               styleClass="price-label"/>

        <HBox alignment="CENTER" spacing="20">
            <Button text="Back"
                    prefWidth="140"
                    onAction="#goBack"/>

            <Button fx:id="addButton" styleClass="primary-button"
                    text="Add to Order"
                    prefWidth="180"
                    onAction="#addToOrder"/>
        </HBox>

    </VBox>
</ScrollPane>
