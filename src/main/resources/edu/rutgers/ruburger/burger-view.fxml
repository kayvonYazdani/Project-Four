<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.rutgers.ruburger.BurgerController"
            fitToWidth="true">

    <VBox alignment="TOP_CENTER" spacing="18"
          style="-fx-background-color: #FFF8F0;">

        <padding>
            <Insets top="25" right="40"
                    bottom="25" left="40"/>
        </padding>

        <Label text="BUILD YOUR BURGER"
               style="-fx-font-size: 30px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #8B0000;"/>

        <Label text="Choose your bread"
               style="-fx-font-size: 17px;"/>

        <ComboBox fx:id="breadBox"
                  prefWidth="260"/>

        <Label text="Patty selection"
               style="-fx-font-size: 17px;"/>

        <HBox alignment="CENTER" spacing="25">
            <RadioButton fx:id="singlePatty"
                         text="Single Patty"
                         onAction="#updatePrice"/>
            <RadioButton fx:id="doublePatty"
                         text="Double Patty (+$2.50)"
                         onAction="#updatePrice"/>
        </HBox>

        <Label text="Add-ons"
               style="-fx-font-size: 17px;"/>

        <HBox alignment="CENTER" spacing="15">
            <CheckBox fx:id="lettuce"
                      text="Lettuce"
                      onAction="#updatePrice"/>
            <CheckBox fx:id="tomatoes"
                      text="Tomatoes"
                      onAction="#updatePrice"/>
            <CheckBox fx:id="onions"
                      text="Onions"
                      onAction="#updatePrice"/>
        </HBox>

        <HBox alignment="CENTER" spacing="20">
            <CheckBox fx:id="avocado"
                      text="Avocado"
                      onAction="#updatePrice"/>
            <CheckBox fx:id="cheese"
                      text="Cheese"
                      onAction="#updatePrice"/>
        </HBox>

        <CheckBox fx:id="combo"
                  text="Make it a Combo (+$2.00)"
                  onAction="#updatePrice"/>

        <HBox alignment="CENTER" spacing="15">
            <VBox alignment="CENTER" spacing="5">
                <Label text="Combo side"/>
                <ComboBox fx:id="comboSideBox"
                          prefWidth="150"
                          onAction="#updateComboSelection"/>
            </VBox>

            <VBox alignment="CENTER" spacing="5">
                <Label text="Combo drink"/>
                <ComboBox fx:id="comboDrinkBox"
                          prefWidth="150"
                          onAction="#updateComboSelection"/>
            </VBox>
        </HBox>

        <Label text="Quantity"/>
        <Spinner fx:id="quantitySpinner"
                 prefWidth="120"
                 editable="false"/>

        <Label text="Total Price"
               style="-fx-font-size: 18px;"/>

        <Label fx:id="priceLabel"
               text="6.99"
               minWidth="180"
               alignment="CENTER"
               style="-fx-font-family: 'Arial';
              -fx-font-size: 28px;
              -fx-font-weight: bold;
              -fx-text-fill: #8B0000;"/>

        <HBox alignment="CENTER" spacing="20">
            <Button text="Back"
                    prefWidth="140"
                    onAction="#goBack"/>

            <Button fx:id="addButton"
                    text="Add to Order"
                    prefWidth="180"
                    onAction="#addToOrder"/>
        </HBox>

    </VBox>
</ScrollPane>
